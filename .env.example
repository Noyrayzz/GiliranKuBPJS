# Salin ke .env untuk mengubah default. Semua nilai di bawah adalah default bawaan kode.
DATABASE_URL=postgres://giliranku:giliranku@127.0.0.1:55432/giliranku
NEXT_PUBLIC_APP_URL=http://localhost:8090
# true = seed/reset demo diizinkan (FR-025). Set false di produksi.
DEMO_MODE=true
# true hanya bila instance dilayani lewat HTTPS; kalau true di http://localhost cookie sesi akan dibuang browser.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
TICKET_VALID_DAYS_AFTER_VISIT=1
