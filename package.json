{
  "name": "giliranku-bpjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 8090",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 8090",
    "start:lan": "next start -H 0.0.0.0 -p 8090",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=lib/domain.ts --coverage.include=lib/validation.ts --coverage.include=lib/security.ts --coverage.include=lib/time.ts --coverage.include=lib/log.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-demo.ts",
    "acceptance": "tsx scripts/acceptance.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "vitest": "^5.1.0"
  }
}
